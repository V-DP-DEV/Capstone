<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_navigation"
    app:startDestination="@id/authLoginFragment">

  <fragment
      android:id="@+id/authLoginFragment"
      android:name="com.example.capstone.ui.auth.AuthLoginFragment"
      android:label="Login"
      tools:layout="@layout/fragment_auth_login">

    <action
        android:id="@+id/action_login_to_signup"
        app:destination="@id/authSignupFragment" />
  </fragment>
  <fragment
      android:id="@+id/authSignupFragment"
      android:name="com.example.capstone.ui.auth.AuthSignupFragment"
      android:label="Signup"
      tools:layout="@layout/fragment_auth_signup">

    <action
        android:id="@+id/action_signup_to_login"
        app:destination="@id/authLoginFragment" />
  </fragment>
</navigation>