<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph2"
    app:startDestination="@id/userDashboardFragment">

  <!-- User Dashboard Screen -->
  <fragment
      android:id="@+id/userDashboardFragment"
      android:name="com.example.capstone.ui.user.UserDashboardFragment"
      android:label="User Dashboard"
      tools:layout="@layout/fragment_user_dashboard">
    <action
        android:id="@+id/action_userDashboardFragment_to_selectDifficultyFragment"
        app:destination="@id/selectDifficultyFragment" />
    <action
        android:id="@+id/action_userDashboardFragment_to_tipsLibraryFragment"
        app:destination="@id/tipsLibraryFragment" />
    <action
        android:id="@+id/action_userDashboardFragment_to_interviewHistoryFragment"
        app:destination="@id/interviewHistoryFragment" />
    <action
        android:id="@+id/action_userDashboardFragment_to_skillAnalysisFragment"
        app:destination="@id/skillsAnalysisFragment" />
    <action
        android:id="@+id/action_userDashboardFragment_self"
        app:destination="@id/userDashboardFragment" />
    <action
        android:id="@+id/action_userDashboardFragment_to_userProfileFragment"
        app:destination="@id/userProfileFragment" />

  </fragment>

  <!-- User Profile Screen -->
  <fragment
      android:id="@+id/userProfileFragment"
      android:name="com.example.capstone.ui.user.UserProfileFragment"
      android:label="User Profile"
      tools:layout="@layout/fragment_user_profile">

    <!-- Action to Edit Profile -->
    <action
        android:id="@+id/action_userProfileFragment_to_editProfileFragment"
        app:destination="@id/editProfileFragment" />

    <!-- Action to Change Password -->
    <action
        android:id="@+id/action_userProfileFragment_to_changePasswordFragment"
        app:destination="@id/changePasswordFragment" />
  </fragment>

  <!-- Edit Profile Screen -->
  <fragment
      android:id="@+id/editProfileFragment"
      android:name="com.example.capstone.ui.user.EditProfileFragment"
      android:label="Edit Profile"
      tools:layout="@layout/fragment_edit_profile" />

  <!-- Change Password Screen -->
  <fragment
      android:id="@+id/changePasswordFragment"
      android:name="com.example.capstone.ui.user.ChangePasswordFragment"
      android:label="Change Password"
      tools:layout="@layout/fragment_change_password" />

  <!-- Select Difficulty Screen -->
  <fragment
      android:id="@+id/selectDifficultyFragment"
      android:name="com.example.capstone.ui.mock.SelectDifficultyFragment"
      android:label="Select Difficulty"
      tools:layout="@layout/fragment_select_difficulty">
    <action
        android:id="@+id/action_selectDifficultyFragment_to_selectInterviewFragment"
        app:destination="@id/selectInterviewFragment" />
    <action
        android:id="@+id/action_selectDifficultyFragment_self"
        app:destination="@id/selectDifficultyFragment" />
  </fragment>

  <!-- Select Interview Screen -->
  <fragment
      android:id="@+id/selectInterviewFragment"
      android:name="com.example.capstone.ui.mock.SelectInterviewFragment"
      android:label="Select Interview"
      tools:layout="@layout/fragment_select_interview" >
    <action
        android:id="@+id/action_selectInterviewFragment_self"
        app:destination="@id/selectInterviewFragment" />
    <action
        android:id="@+id/action_selectInterviewFragment_to_mockInterviewInstructionsFragment"
        app:destination="@id/mockInterviewInstructionsFragment" />
  </fragment>

  <!-- Mock Interview Instructions Screen -->
  <fragment
      android:id="@+id/mockInterviewInstructionsFragment"
      android:name="com.example.capstone.ui.mock.MockInterviewInstructionsFragment"
      android:label="Mock Interview Instructions"
      tools:layout="@layout/fragment_mock_interview_instructions">
    <action
        android:id="@+id/action_mockInterviewInstructionsFragment_to_mockInterviewQuestionsFragment"
        app:destination="@id/mockInterviewQuestionsFragment" />
  </fragment>

  <!-- Mock Interview Questions Screen -->
  <fragment
      android:id="@+id/mockInterviewQuestionsFragment"
      android:name="com.example.capstone.ui.mock.MockInterviewQuestionsFragment"
      android:label="Mock Interview Questions"
      tools:layout="@layout/fragment_mock_interview_questions">
    <action
        android:id="@+id/action_mockInterviewQuestions_to_mockInterviewResult"
        app:destination="@id/mockInterviewResult" />
  </fragment>

  <!-- Mock Interview Result Screen -->
  <fragment
      android:id="@+id/mockInterviewResult"
      android:name="com.example.capstone.ui.mock.MockInterviewResult"
      android:label="Mock Interview Result"
      tools:layout="@layout/fragment_mock_interview_result" >
    <action
        android:id="@+id/action_mockInterviewResult_to_reviewInterviewFragment"
        app:destination="@id/reviewInterviewFragment" />
    <action
        android:id="@+id/action_mockInterviewResult_to_reviewQuestionFragment"
        app:destination="@id/reviewQuestionFragment" />
  </fragment>

  <!-- Review Interview Screen -->
  <fragment
      android:id="@+id/reviewInterviewFragment"
      android:name="com.example.capstone.ui.review.ReviewInterviewFragment"
      android:label="Review Interview"
      tools:layout="@layout/fragment_review_interview">

    <!-- Add this action so it can navigate to the question review -->
    <action
        android:id="@+id/action_reviewInterviewFragment_to_reviewQuestionFragment"
        app:destination="@id/reviewQuestionFragment" />

  </fragment>

  <!-- Review Question Screen -->
  <fragment
      android:id="@+id/reviewQuestionFragment"
      android:name="com.example.capstone.ui.review.ReviewQuestionFragment"
      android:label="Review Question"
      tools:layout="@layout/fragment_review_question">

    <!-- Action to return to difficulty selection upon finishing review -->
    <action
        android:id="@+id/action_reviewQuestionFragment_to_selectDifficultyFragment"
        app:destination="@id/selectDifficultyFragment"
        app:popUpTo="@id/selectDifficultyFragment"
        app:popUpToInclusive="false" />

    <action
        android:id="@+id/action_reviewQuestionFragment_to_userDashboardFragment"
        app:destination="@id/userDashboardFragment"
        app:popUpTo="@id/userDashboardFragment"
        app:popUpToInclusive="false" />
  </fragment>

  <!-- Tips & Library Screen -->
  <fragment
      android:id="@+id/tipsLibraryFragment"
      android:name="com.example.capstone.ui.user.TipsLibraryFragment"
      android:label="Tips &amp; Library"
      tools:layout="@layout/fragment_tips_library">
    <action
        android:id="@+id/action_tipsLibraryFragment_to_homeFragment"
        app:destination="@id/userDashboardFragment" />
    <action
        android:id="@+id/action_tipsLibraryFragment_to_selectInterviewFragment"
        app:destination="@id/selectInterviewFragment" />
  </fragment>

  <!-- Interview History Screen -->
  <fragment
      android:id="@+id/interviewHistoryFragment"
      android:name="com.example.capstone.ui.review.InterviewHistoryFragment"
      android:label="Interview History"
      tools:layout="@layout/fragment_interview_history">
    <action
        android:id="@+id/action_history_to_review"
        app:destination="@id/reviewInterviewFragment" />
  </fragment>

  <!-- Skills Analysis Screen -->
  <fragment
      android:id="@+id/skillsAnalysisFragment"
      android:name="com.example.capstone.ui.analysis.SkillsAnalysisFragment"
      android:label="Skills Analysis"
      tools:layout="@layout/fragment_skills_analysis" />


</navigation>
