<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

  <!-- Header Avatar -->
  <ImageButton
      android:id="@+id/img_profile_avatar"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginStart="24dp"
      android:layout_marginTop="16dp"
      android:background="@drawable/bg_circle_action"
      android:backgroundTint="#33312CAA"
      android:contentDescription="User Profile"
      android:padding="10dp"
      android:scaleType="centerInside"
      android:src="@drawable/ic_person"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:tint="@color/primary_blue" />

  <!-- Main Content -->
  <androidx.core.widget.NestedScrollView
      android:id="@+id/scrollView"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:clipToPadding="false"
      android:paddingBottom="16dp"
      app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/img_profile_avatar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp">

      <!-- Hero Card -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/card_background"
          app:cardCornerRadius="24dp"
          app:cardElevation="2dp"
          app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Improve your skills\nToday!!"
              android:textColor="@color/text_primary"
              android:textSize="22sp"
              android:textStyle="bold" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:text="Build interview confidence"
              android:textColor="@color/text_secondary"
              android:textSize="13sp" />

          <Button
              android:id="@+id/btn_start_mock_interview"
              android:layout_width="wrap_content"
              android:layout_height="48dp"
              android:layout_marginTop="16dp"
              android:background="@drawable/bg_berry_pill_button"
              android:paddingHorizontal="20dp"
              android:text="Start Mock Interview"
              android:textAllCaps="false"
              android:textColor="@color/card_background"
              android:textSize="14sp"
              app:backgroundTint="@null" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Monthly Progress Section -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:text="Monthly Progress"
          android:textColor="@color/text_primary"
          android:textSize="16sp"
          android:textStyle="bold" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:orientation="horizontal">

        <com.example.capstone.ui.components.ProgressCardView
            android:id="@+id/total_month"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1" />

        <com.example.capstone.ui.components.ProgressCardView
            android:id="@+id/total_week"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1" />

        <com.example.capstone.ui.components.ProgressCardView
            android:id="@+id/total_difficult"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />
      </LinearLayout>

      <!-- Quick Actions Section -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:text="Quick actions"
          android:textColor="@color/text_primary"
          android:textSize="16sp"
          android:textStyle="bold" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:orientation="horizontal"
          android:weightSum="4"
          android:gravity="center">

        <!-- 1. Start Interview -->
        <LinearLayout
            android:id="@+id/btn_start_interview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp">

          <ImageView
              android:layout_width="56dp"
              android:layout_height="56dp"
              android:background="@drawable/bg_white_circle"
              android:padding="14dp"
              android:src="@drawable/ic_start_interview"
              app:tint="@color/primary_blue" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:gravity="center"
              android:textAlignment="center"
              android:textColor="@android:color/black"
              android:textSize="13sp"
              android:text="Start\ninterview" />
        </LinearLayout>

        <!-- 2. View Previous Interviews -->

        <!-- 3. Tips & Library -->
        <LinearLayout
            android:id="@+id/btn_view_interviews"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

          <ImageView
              android:layout_width="56dp"
              android:layout_height="56dp"
              android:background="@drawable/bg_white_circle"
              android:padding="14dp"
              android:src="@drawable/ic_bar_chart"
              app:tint="@color/progress_green" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:gravity="center"
              android:text="View\nprevious\ninterviews"
              android:textAlignment="center"
              android:textColor="@android:color/black"
              android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_tips_library"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp">

          <ImageView
              android:layout_width="56dp"
              android:layout_height="56dp"
              android:background="@drawable/bg_white_circle"
              android:padding="14dp"
              android:src="@drawable/ic_school"
              app:tint="@color/primary_berry" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:gravity="center"
              android:textAlignment="center"
              android:textColor="@android:color/black"
              android:textSize="13sp"
              android:text="Tips &amp;\nLibrary" />
        </LinearLayout>

        <!-- 4. Disabled Slot / Extra -->
        <LinearLayout
            android:id="@+id/btn_skills_anaylsis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp">
          <ImageView
              android:layout_width="56dp"
              android:layout_height="56dp"
              android:background="@drawable/bg_white_circle"
              android:padding="14dp"
              android:src="@drawable/ic_database"
              app:tint="@color/color_orange_progress" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:gravity="center"
              android:textAlignment="center"
              android:textColor="@android:color/black"
              android:textSize="14sp"
              android:text="Skills Analysis" />
        </LinearLayout>

      </LinearLayout>

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <!-- Floating Rounded Bottom Bar -->
  <include
      android:id="@+id/bottom_nav_container"
      layout="@layout/component_user_nav_bar"
      android:layout_width="0dp"
      android:layout_height="64dp"
      android:layout_marginHorizontal="0dp"
      android:layout_marginBottom="0dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>