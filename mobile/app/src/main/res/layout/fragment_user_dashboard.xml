<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

  <!-- Header Avatar -->
  <ImageView
      android:id="@+id/img_profile_avatar"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginStart="24dp"
      android:layout_marginTop="16dp"
      android:background="@drawable/bg_circle_action"
      android:backgroundTint="@color/white"
      android:padding="10dp"
      android:src="@drawable/ic_person"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:tint="@color/primary_blue" />

  <!-- Main Content -->
  <androidx.core.widget.NestedScrollView
      android:id="@+id/scrollView"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:clipToPadding="false"
      android:paddingBottom="16dp"
      app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/img_profile_avatar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp">

      <!-- Hero Card -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/card_background"
          app:cardCornerRadius="24dp"
          app:cardElevation="2dp"
          app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Improve your skills\nToday!!"
              android:textColor="@color/text_primary"
              android:textSize="22sp"
              android:textStyle="bold" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:text="Build interview confidence"
              android:textColor="@color/text_secondary"
              android:textSize="13sp" />

          <Button
              android:id="@+id/btn_start_mock_interview"
              android:layout_width="wrap_content"
              android:layout_height="44dp"
              android:layout_marginTop="16dp"
              android:background="@drawable/bg_berry_pill_button"
              android:paddingHorizontal="20dp"
              android:text="Start Mock Interview"
              android:textAllCaps="false"
              android:textColor="@color/card_background"
              android:textSize="14sp"
              app:backgroundTint="@null" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Monthly Progress Section -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:text="Monthly Progress"
          android:textColor="@color/text_primary"
          android:textSize="16sp"
          android:textStyle="bold" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:orientation="horizontal">

        <com.example.capstone.ui.components.ProgressCardView
            android:id="@+id/progress_card_interviews"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1" />

        <com.example.capstone.ui.components.ProgressCardView
            android:id="@+id/progress_card_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />
      </LinearLayout>

      <!-- Quick Actions Section -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:text="Quick actions"
          android:textColor="@color/text_primary"
          android:textSize="16sp"
          android:textStyle="bold" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:orientation="horizontal">

        <com.example.capstone.ui.components.QuickActionView
            android:id="@+id/action_start_interview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:actionIcon="@drawable/ic_start_interview"
            app:actionTint="@color/primary_blue"
            app:actionTitle="Start\ninterview" />

        <com.example.capstone.ui.components.QuickActionView
            android:id="@+id/action_view_interviews"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:actionIcon="@drawable/ic_bar_chart"
            app:actionTint="@color/progress_green"
            app:actionTitle="View\nprevious\ninterviews" />

        <com.example.capstone.ui.components.QuickActionView
            android:id="@+id/action_tips_library"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:actionIcon="@drawable/ic_school"
            app:actionTint="@color/primary_berry"
            app:actionTitle="Tips &amp;\nLibrary" />

        <com.example.capstone.ui.components.QuickActionView
            android:id="@+id/action_disabled_slot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:actionIcon="@drawable/ic_circle_outline"
            app:actionTint="@color/text_disabled"
            app:actionTitle="View\nprevious\ninterviews" />
      </LinearLayout>

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <!-- Floating Rounded Bottom Bar -->
  <include
      android:id="@+id/bottom_nav_container"
      layout="@layout/component_bottom_nav_bar"
      android:layout_width="0dp"
      android:layout_height="64dp"
      android:layout_marginHorizontal="0dp"
      android:layout_marginBottom="0dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>