<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvSubMetricName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#FF000000"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/tvSubMetricPercentage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubMetricPercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF08B425"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Progress Track Background -->
    <View
        android:id="@+id/trackSubMetric"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubMetricName" />

    <!-- Progress Fill Bar -->
    <View
        android:id="@+id/indicatorSubMetric"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_indicator_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubMetricName" />

</androidx.constraintlayout.widget.ConstraintLayout>
