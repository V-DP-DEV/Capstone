<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6F8FC">

    <!-- Top Navigation Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/div_topbar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#FFFCFDFE"
        android:paddingStart="26dp"
        android:paddingTop="6dp"
        android:paddingEnd="26dp"
        android:paddingBottom="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FF6C63D6" />

        <TextView
            android:id="@+id/review_interview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Review interview"
            android:textColor="#FF1C1C28"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sub-header Meta Data Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/div_subbar"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="#FFFCFDFE"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingBottom="19dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/div_topbar">

        <TextView
            android:id="@+id/c_developer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="C# Developer"
            android:textColor="#FF8A8A97"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/hard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif"
            android:text="Hard"
            android:textColor="#FFE49596"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/c_developer"
            app:layout_constraintStart_toEndOf="@id/c_developer"
            app:layout_constraintTop_toTopOf="@id/c_developer" />

        <TextView
            android:id="@+id/tv_10_questions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="10 questions"
            android:textColor="#FF8A8A97"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="01:24 /20 minutes"
            android:textColor="#FF08B425"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/c_developer" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="18 August 2026"
            android:textColor="#FF8A8A97"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_10_questions" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/div_pill_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/div_subbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="16dp"
            android:paddingEnd="26dp"
            android:paddingBottom="26dp">

            <!-- Competencies Section Header -->
            <TextView
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif"
                android:text="Competencies"
                android:textColor="#FF000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Competencies Summary Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_competencies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_tech_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Technical"
                    android:textColor="#FF000000"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_tech_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Strong"
                    android:textColor="#FF000000"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_tech_title" />

                <TextView
                    android:id="@+id/tv_score_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="80%"
                    android:textColor="#FF08B425"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_tech_sub" />

                <TextView
                    android:id="@+id/tv_total_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Total 3"
                    android:textColor="#FF000000"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_score_percent" />

                <!-- Bar 1 -->
                <TextView
                    android:id="@+id/tv_label_tradeoffs_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trade-offs"
                    android:textColor="#FF000000"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="@id/guideline_bars"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_percent_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10%"
                    android:textColor="#FF000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/bar_1"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_rounded"
                    android:backgroundTint="#FFE49596"
                    app:layout_constraintEnd_toEndOf="@id/tv_percent_1"
                    app:layout_constraintStart_toStartOf="@id/tv_label_tradeoffs_1"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_tradeoffs_1" />

                <!-- Bar 2 -->
                <TextView
                    android:id="@+id/tv_label_tradeoffs_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Trade-offs"
                    android:textColor="#FF000000"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="@id/guideline_bars"
                    app:layout_constraintTop_toBottomOf="@id/bar_1" />

                <TextView
                    android:id="@+id/tv_percent_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="#FF000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_label_tradeoffs_2" />

                <View
                    android:id="@+id/bar_2"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_rounded"
                    android:backgroundTint="#FFF7A93B"
                    app:layout_constraintEnd_toEndOf="@id/tv_percent_2"
                    app:layout_constraintStart_toStartOf="@id/tv_label_tradeoffs_2"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_tradeoffs_2" />

                <!-- Bar 3 -->
                <TextView
                    android:id="@+id/tv_label_tradeoffs_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Trade-offs"
                    android:textColor="#FF000000"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="@id/guideline_bars"
                    app:layout_constraintTop_toBottomOf="@id/bar_2" />

                <TextView
                    android:id="@+id/tv_percent_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80%"
                    android:textColor="#FF000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_label_tradeoffs_3" />

                <View
                    android:id="@+id/bar_3"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_rounded"
                    android:backgroundTint="#FF08B425"
                    app:layout_constraintEnd_toEndOf="@id/tv_percent_3"
                    app:layout_constraintStart_toStartOf="@id/tv_label_tradeoffs_3"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_tradeoffs_3" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_bars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.38" />

                <!-- Expandable Section: Strengths -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/section_strengths"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_rounded"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_total_count">

                    <TextView
                        android:id="@+id/tv_strengths_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Strengths"
                        android:textColor="#FF000000"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textColor="#FF000000"
                        android:textSize="20sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Expandable Section: Areas to Improve -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/section_areas_improve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rounded"
                    android:padding="16dp"
                    app:layout_constraintTop_toBottomOf="@id/section_strengths">

                    <TextView
                        android:id="@+id/tv_areas_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Areas to improve"
                        android:textColor="#FF000000"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textColor="#FF000000"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Item 1: Structure -->
                    <View
                        android:id="@+id/dot_structure"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_rounded"
                        android:backgroundTint="#FF08B425"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_areas_title" />

                    <TextView
                        android:id="@+id/tv_structure_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Structure"
                        android:textColor="#FF000000"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/dot_structure"
                        app:layout_constraintTop_toTopOf="@id/dot_structure" />

                    <TextView
                        android:id="@+id/tv_structure_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus on SQL and C# error handling"
                        android:textColor="#FF8A8A97"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@id/tv_structure_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_structure_title" />

                    <!-- Item 2: Clarity -->
                    <View
                        android:id="@+id/dot_clarity"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_rounded"
                        android:backgroundTint="#FFE49596"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_structure_desc" />

                    <TextView
                        android:id="@+id/tv_clarity_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Clarity"
                        android:textColor="#FF000000"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/dot_clarity"
                        app:layout_constraintTop_toTopOf="@id/dot_clarity" />

                    <TextView
                        android:id="@+id/tv_clarity_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Try and explain problem solving better"
                        android:textColor="#FF8A8A97"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@id/tv_clarity_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_clarity_title" />

                    <!-- Item 3: Communication -->
                    <View
                        android:id="@+id/dot_comm"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_rounded"
                        android:backgroundTint="#FFF7A93B"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_clarity_desc" />

                    <TextView
                        android:id="@+id/tv_comm_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Communication"
                        android:textColor="#FF000000"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/dot_comm"
                        app:layout_constraintTop_toTopOf="@id/dot_comm" />

                    <TextView
                        android:id="@+id/tv_comm_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Structure better, focusing on 1 thing and building off it"
                        android:textColor="#FF8A8A97"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@id/tv_comm_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_comm_title" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Question Review RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_q_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_questions" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/div_pill_btn"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_margin="19dp"
        android:background="@drawable/bg_berry_pill_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/review_questions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Review questions"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/bottom_nav_container"
        layout="@layout/component_bottom_nav_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>