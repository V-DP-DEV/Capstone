<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_marginStart="26dp"
    android:layout_marginEnd="26dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card_white"
    android:padding="16dp">

    <!-- Card Title & Overall Status -->
    <TextView
        android:id="@+id/card_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Communication"
        android:textColor="#FF000000"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/card_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Strong"
        android:textColor="#FF000000"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_title" />

    <TextView
        android:id="@+id/card_percentage_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="80%"
        android:textColor="#FF08B425"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_status"
        android:layout_marginTop="4dp" />

    <!-- Metric 1: Clarity (Pink Indicator) -->
    <TextView
        android:id="@+id/label_clarity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Clarity"
        android:textColor="#FF000000"
        android:textSize="14sp"
        android:layout_marginStart="120dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/indicator_clarity"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_tab_sub"
        android:backgroundTint="#FFE49596"
        app:layout_constraintStart_toStartOf="@id/label_clarity"
        app:layout_constraintTop_toBottomOf="@id/label_clarity" />

    <TextView
        android:id="@+id/value_clarity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="10%"
        android:textColor="#FF000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Metric 2: Structure (Orange Indicator) -->
    <TextView
        android:id="@+id/label_structure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Structure"
        android:textColor="#FF000000"
        android:textSize="14sp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/indicator_clarity" />

    <View
        android:id="@+id/indicator_structure"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_tab_sub"
        android:backgroundTint="#FFF7A93B"
        app:layout_constraintStart_toStartOf="@id/label_structure"
        app:layout_constraintTop_toBottomOf="@id/label_structure" />

    <TextView
        android:id="@+id/value_structure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="50%"
        android:textColor="#FF000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/label_structure" />

    <!-- Metric 3: Vocabulary (Green Bar Indicator) -->
    <TextView
        android:id="@+id/label_vocabulary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Vocabulary"
        android:textColor="#FF000000"
        android:textSize="14sp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/indicator_structure" />

    <View
        android:id="@+id/indicator_vocabulary"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_indicator_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/label_vocabulary"
        app:layout_constraintTop_toBottomOf="@id/label_vocabulary" />

    <TextView
        android:id="@+id/value_vocabulary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="80%"
        android:textColor="#FF000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/label_vocabulary" />

</androidx.constraintlayout.widget.ConstraintLayout>