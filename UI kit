<FrameLayout xmlns:android="http://android.com"
    android:id="@+id/Frame_1000006028"
    android:layout_width="440dp"
    android:layout_height="110dp">

    <LinearLayout
        android:id="@+id/Navigation_Bar"
        android:layout_width="440dp"
        android:layout_height="110dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/Nav_Wrapper"
            android:layout_width="384dp"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Button 1 -->
            <LinearLayout
                android:id="@+id/Button_Rounded_1"
                android:layout_width="72dp"
                android:layout_height="54dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/Outline_Icons_Home"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:tint="#312CAA" />

                <TextView
                    android:id="@+id/Text_Home"
                    android:layout_width="29dp"
                    android:layout_height="7dp"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:text="Home"
                    android:textColor="#868DA6"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Button 2 -->
            <LinearLayout
                android:id="@+id/Button_Rounded_2"
                android:layout_width="72dp"
                android:layout_height="54dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/Outline_Icons_Search"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:tint="#868DA6" />

                <TextView
                    android:id="@+id/Text_Search"
                    android:layout_width="34dp"
                    android:layout_height="7dp"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:text="Search"
                    android:textColor="#868DA6"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Button 3 (Truncated in original source) -->
            <LinearLayout
                android:id="@+id/Button_Rounded_3"
                android:layout_width="72dp"
                android:layout_height="54dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/Outline_Icons_Plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>




